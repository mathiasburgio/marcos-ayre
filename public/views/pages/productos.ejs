<div id="productos" class="container" data-evento-en-curso="<%= eventoEnCurso %>">
    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="card card-primary card-outline">
                <div class="card-header font-weight-bold">
                    Productos
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col">
                            <button type="button" class="btn btn-primary btn-flat btn-block" id="nuevo">Nuevo</button>
                        </div>
                        <div class="col">
                            <button type="button" class="btn btn-primary btn-flat btn-block" id="modificar">Modificar</button>
                        </div>
                        <div class="col">
                            <button type="button" class="btn btn-danger btn-flat btn-block" id="eliminar">Eliminar</button>
                        </div>
                    </div>
                    <input type="search" class="form-control my-3" id="buscar" placeholder="Buscar...">
                    <div class="border table-responsive table-scroll">
                        <table class="table table-sm mb-0" id="listado-productos">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Nombre</th>
                                    <th class="text-right">Precio</th>
                                    <th class="text-right">Stock</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card card-primary card-outline">
                <div class="card-header font-weight-bold">
                    Datos <span class="badge badge-info" id="accion"></span>
                </div>
                <form class="card-body" id="datos">
                    <div class="form-group">
                        <label for="nombre">Nombre</label>
                        <input type="text" class="form-control" id="nombre" maxlength="200" required>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-4">
                            <div class="form-group">
                                <label for="costo">Costo</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" id="costo" min="0" step="1" value="0" required>
                                    <div class="input-group-append"><span class="input-group-text">$</span></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-4">
                            <div class="form-group">
                                <label for="margenGanancia">Margen</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" id="margenGanancia" min="-100" step="1" value="0">
                                    <div class="input-group-append"><span class="input-group-text">%</span></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-4">
                            <div class="form-group">
                                <label for="precio">Precio venta</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" id="precio" min="0" step="1" value="0" required>
                                    <div class="input-group-append"><span class="input-group-text">$</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="stock">Stock</label>
                        <div class="input-group">
                            <input type="number" class="form-control" id="stock" step="1" value="0" required>
                            <div class="input-group-append">
                                <button type="button" class="btn btn-light btn-flat border" id="info-stock" aria-label="Información sobre el stock"><i class="fas fa-info-circle" aria-hidden="true"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="visible" class="mb-0 cp">
                            <input type="checkbox" id="visible" class="toggle" checked>
                            Visible en ventas
                        </label>
                    </div>
                    <div class="text-right">
                        <button type="submit" class="btn btn-primary btn-flat" id="guardar">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
