<div id="ventas" data-evento-id="<%= evento?.id || '' %>">
    <% if(!evento){ %>
        <p class="alert alert-info">No hay ningún evento activo. Activá un evento para registrar ventas y mesas.</p>
    <% }else{ %>
        <div class="row">
            <div class="col-12 col-lg-6 mb-3">
                <section class="card card-primary card-outline h-100">
                    <div class="card-header d-flex align-items-center">
                        <strong class="mr-3">Productos</strong>
                        <button type="button" class="btn btn-primary btn-flat" id="gestionar-mesas"><i class="fas fa-chair mr-1"></i> Gestionar mesas</button>
                    </div>
                    <div class="card-body">
                        <input type="search" class="form-control mb-3" id="buscar-producto" placeholder="Buscar producto..." aria-label="Buscar producto">
                        <div class="border rounded" style="height: 65vh; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-0" id="listado-productos-venta">
                                <thead class="thead-dark"><tr><th>Nombre</th><th class="text-right">Precio</th><th></th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </section>
            </div>
            <div class="col-12 col-lg-6 mb-3">
                <section class="card card-success card-outline">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Productos que se va a llevar</strong>
                        <label class="mb-0 d-flex align-items-center">
                            <input type="checkbox" class="toggle mr-2" id="agrupar-iguales">
                            Agrupar iguales
                        </label>
                    </div>
                    <div class="card-body">
                        <div class="border rounded" style="height: 60vh; overflow-y: auto;">
                            <table class="table table-sm mb-0" id="listado-carrito">
                                <thead class="thead-dark"><tr><th>Producto</th><th class="text-right">Cantidad</th><th class="text-right">Subtotal</th><th></th></tr></thead>
                                <tbody><tr><td colspan="4" class="text-muted">No hay productos en el ticket</td></tr></tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-top mt-3 pt-3">
                            <button type="button" class="btn btn-sm btn-danger btn-flat" id="limpiar-ticket" disabled>Limpiar lista</button>
                            <div class="text-right">
                                <span class="text-muted mr-2">Total</span>
                                <strong class="h3" id="total-ticket">$ 0</strong>
                            </div>
                        </div>
                        <button type="button" class="btn btn-success btn-flat btn-block mt-3" id="cobrar-venta" disabled>COBRAR</button>
                    </div>
                </section>
            </div>
        </div>
    <% } %>
</div>
<div id="modal-cobrar-venta" class="d-none">
    <div id="cobro-venta">
        <p class="h5 mb-3">Total: <strong id="cobro-total"></strong></p>
        <div class="row">
            <form class="col-12 col-md-6 mb-3 mb-md-0" data-tipo-cobro="abonar" novalidate>
                <div class="border rounded p-3 h-100 d-flex flex-column">
                    <h3 class="h5 mb-3">ABONAR</h3>
                    <div class="form-group">
                        <label for="cobro-efectivo">Efectivo</label>
                        <div class="input-group">
                            <input type="number" id="cobro-efectivo" class="form-control" min="0" step="1">
                            <div class="input-group-append">
                                <button type="button" class="btn btn-danger btn-flat" data-borrar-pago="efectivo" aria-label="Borrar importe en efectivo" disabled><i class="fas fa-times" aria-hidden="true"></i></button>
                                <button type="button" class="btn btn-primary btn-flat" data-completar-pago="efectivo">Completar</button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="cobro-transferencia">Transferencia</label>
                        <div class="input-group">
                            <input type="number" id="cobro-transferencia" class="form-control" min="0" step="1">
                            <div class="input-group-append">
                                <button type="button" class="btn btn-danger btn-flat" data-borrar-pago="transferencia" aria-label="Borrar importe en transferencia" disabled><i class="fas fa-times" aria-hidden="true"></i></button>
                                <button type="button" class="btn btn-primary btn-flat" data-completar-pago="transferencia">Completar</button>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success btn-flat btn-block mt-auto" data-confirmar-abono disabled>Confirmar</button>
                </div>
            </form>
            <form class="col-12 col-md-6" data-tipo-cobro="mesa">
                <div class="border rounded p-3 h-100 d-flex flex-column">
                    <h3 class="h5 mb-3">MESAS</h3>
                    <div class="table-responsive mb-3" style="max-height: 40vh; overflow-y: auto;">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="thead-dark"><tr><th></th><th>Nº</th><th>Nombre</th><th></th></tr></thead>
                            <tbody id="cobro-listado-mesas"><tr><td colspan="4" class="text-muted">Cargando mesas...</td></tr></tbody>
                        </table>
                    </div>
                    <button type="submit" class="btn btn-success btn-flat btn-block mt-auto" data-confirmar-mesa disabled>Confirmar</button>
                </div>
            </form>
        </div>
    </div>
</div>
