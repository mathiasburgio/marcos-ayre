<div id="inicio">
    <div class="row">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-primary card-outline h-100">
                <div class="card-body">
                    <div class="text-muted">Evento actual</div>
                    <h2 class="h4 mb-0"><%= evento?.nombre || 'Sin evento activo' %></h2>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-success card-outline h-100">
                <div class="card-body">
                    <div class="text-muted">Ventas del evento</div>
                    <h2 class="h3 mb-0"><%= cantidadVentas %></h2>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-info card-outline h-100">
                <div class="card-body">
                    <div class="text-muted">Dominio del servidor</div>
                    <h2 class="h4 mb-0 text-break"><%= dominio %></h2>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-warning card-outline h-100">
                <div class="card-body">
                    <div class="text-muted">IP del servidor</div>
                    <h2 class="h4 mb-0"><%= ip %></h2>
                </div>
            </div>
        </div>
    </div>
    <div class="card bg-light border mt-3 text-muted">
        <div class="card-header bg-transparent font-weight-bold text-dark">Conexión desde otro dispositivo</div>
        <div class="card-body">
            <p>Para conectarse al servidor desde otro dispositivo, asegurese que ambos dispositivos estén conectados a la misma red Wi-Fi. Después, abrír el navegador web en el otro dispositivo e ingresar una de estas direcciones:</p>
            <ul class="mb-3">
                <li><code>http://<%= dominio %>:<%= puerto %></code></li>
                <li><code>http://<%= ip %>:<%= puerto %></code></li>
            </ul>
            <div class="d-flex flex-wrap justify-content-between align-items-center border-top pt-3">
                <span class="small mr-3 mb-2 mb-md-0"><i class="fas fa-print mr-1" aria-hidden="true"></i>Para imprimir desde este dispositivo, elegír <strong>Impresora: Local</strong> en Preferencias. Si desea imprimir directamente en el servidor, elegír <strong>Impresora: Servidor</strong> para enviar la impresión a la PC servidor.</span>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-flat" id="configurar-impresora"><i class="fas fa-sliders-h mr-1" aria-hidden="true"></i> Configurar impresora</button>
            </div>
            <small class="d-block border-top mt-3 pt-3"><i class="fas fa-info-circle mr-1" aria-hidden="true"></i>El usuario <strong>admin@admin.com</strong> solo es válido en la PC servidor.</small>
        </div>
    </div>
    <% if(usuario?.esAdmin && esServidor){ %>
        <div class="card card-outline card-secondary mt-3">
            <div class="card-header font-weight-bold">Base de datos</div>
            <div class="card-body">
                <button type="button" class="btn btn-primary mr-2 mb-2" id="respaldar-base-datos">
                    <i class="fas fa-download mr-1" aria-hidden="true"></i> Respaldar
                </button>
                <button type="button" class="btn btn-warning mb-2" id="restaurar-base-datos" <%= restoreHabilitado ? '' : 'disabled title="La restauración está deshabilitada en config.json"' %>>
                    <i class="fas fa-upload mr-1" aria-hidden="true"></i> Restaurar
                </button>
            </div>
        </div>
    <% } %>
</div>
<div id="modales" class="d-none">
    <section name="modal-inicio-login">
        <div class="card card-outline card-primary shadow-sm text-dark w-50 mt-5 mx-auto">
            <div class="card-header text-center">
                <h1 class="h5 mb-0">Iniciar sesión</h1>
            </div>
            <div class="card-body p-4 text-left">
                <form id="form-iniciar-sesion">
                    <div class="form-group">
                        <label for="inicio-email">Email</label>
                        <input type="email" class="form-control" id="inicio-email" name="email" placeholder="usuario@dominio.com" autocomplete="username" required>
                    </div>
                    <div class="form-group">
                        <label for="inicio-contrasena">Contraseña</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="inicio-contrasena" name="contrasena" autocomplete="current-password" required>
                            <div class="input-group-append">
                                <button type="button" class="btn btn-outline-secondary" id="mostrar-contrasena" name="mostrar-contrasena" title="Mostrar contraseña" aria-label="Mostrar contraseña" aria-controls="inicio-contrasena">
                                    <i class="fas fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-primary btn-block mt-4" id="iniciar-sesion">
                        <i class="fas fa-sign-in-alt mr-2" aria-hidden="true"></i>Iniciar sesión
                    </button>
                </form>
            </div>
        </div>
        <% if(esLocalhost && adminHabilitado){ %>
            <div class="card bg-light border w-50 mx-auto mt-3 mb-0 text-muted">
                <div class="card-body py-3 px-4 small">
                    <div class="font-weight-bold mb-1">Acceso de administrador</div>
                    <div>Usuario: <strong>admin@admin.com</strong> · Contraseña: <strong>123456789</strong></div>
                    <div class="mt-1"><i class="fas fa-desktop mr-1" aria-hidden="true"></i>El usuario admin solo es válido en la PC servidor.</div>
                </div>
            </div>
        <% } %>
    </section>
</div>
