<div id="inicio">
    <div class="row">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    Evento
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card">
                <div class="card-body">
                    Ventas
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card">
                <div class="card-body">
                    Dominio servidor
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card">
                <div class="card-body">
                    IP servidor
                </div>
            </div>
        </div>
    </div>
</div>
<div id="modales" class="d-none">
    <section name="modal-inicio-login">
        <div class="card card-outline card-primary shadow-sm text-dark w-50 mt-5 mx-auto">
            <div class="card-header text-center">
                <h1 class="h5 mb-0">Iniciar sesión</h1>
            </div>
            <div class="card-body p-4 text-left">
                <form id="form-iniciar-sesion">
                    <div class="form-group">
                        <label for="inicio-email">Email</label>
                        <input type="email" class="form-control" id="inicio-email" name="email" placeholder="usuario@dominio.com" autocomplete="username" required>
                    </div>
                    <div class="form-group">
                        <label for="inicio-contrasena">Contraseña</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="inicio-contrasena" name="contrasena" autocomplete="current-password" required>
                            <div class="input-group-append">
                                <button type="button" class="btn btn-outline-secondary" id="mostrar-contrasena" name="mostrar-contrasena" title="Mostrar contraseña" aria-label="Mostrar contraseña" aria-controls="inicio-contrasena">
                                    <i class="fas fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-primary btn-block mt-4" id="iniciar-sesion">
                        <i class="fas fa-sign-in-alt mr-2" aria-hidden="true"></i>Iniciar sesión
                    </button>
                </form>
            </div>
        </div>
    </section>
</div>